# Neon Postgres connection string for the app (pooled). Neon project "Launch app", branch `production`,
# shared with the launch app (docs/decisions/0004). Server-only: never NEXT_PUBLIC_.
DATABASE_URL=
# Neon test-branch connection string; integration tests use ONLY this, never DATABASE_URL.
TEST_DATABASE_URL=
# Base URL of the Neon Auth server for this project.
NEON_AUTH_BASE_URL=
# Random secret (32+ chars) used to sign Neon Auth session cookies.
NEON_AUTH_COOKIE_SECRET=
# Public origin of this app, used to build invite links (e.g. http://localhost:3000).
APP_URL=
